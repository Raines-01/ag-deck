[Unit]
Description=AG Deck — dashboard for Antigravity Cascade sessions
Documentation=https://github.com/your-name/ag-deck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path if `which agdeck` points somewhere else (pipx uses ~/.local/bin)
ExecStart=%h/.local/bin/agdeck serve --port 8848
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# systemd user services do not inherit your shell proxy settings; uncomment if
# Antigravity itself needs a proxy (AG Deck only talks to loopback, so this is
# rarely needed).
# Environment=HTTPS_PROXY=http://127.0.0.1:7897

[Install]
WantedBy=default.target
