<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="refresh"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_refresh">
        <intent
            android:action="io.agdeck.console.REFRESH"
            android:targetPackage="io.agdeck.console"
            android:targetClass="io.agdeck.console.MainActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_settings">
        <intent
            android:action="io.agdeck.console.SETTINGS"
            android:targetPackage="io.agdeck.console"
            android:targetClass="io.agdeck.console.MainActivity" />
    </shortcut>

</shortcuts>
